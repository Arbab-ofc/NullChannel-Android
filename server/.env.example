PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Use the existing custom endpoint when its slug also names the upload folder.
# NullChannel: https://ik.imagekit.io/<account-id>/nullchannel
# Keep the full /nullchannel/... filePath when signing; do not strip its folder.
IMAGEKIT_URL_ENDPOINT=
CLEANUP_SECRET=

# Production: loopback listener behind the dedicated Nginx site.
HOST=127.0.0.1
UPLOAD_CONCURRENCY=2
IMAGEKIT_TIMEOUT_MS=60000
SOCKET_JOIN_LIMIT=30
SOCKET_MESSAGE_LIMIT=120
SOCKET_TYPING_LIMIT=180
REST_MUTATION_LIMIT=120
REST_MANAGEMENT_LIMIT=20

DATABASE_TIMEOUT_MS=15000
SOCKET_CONNECTION_LIMIT=60

# Optional private-room voice calling limits (milliseconds unless indicated).
CALL_RING_TIMEOUT_MS=30000
CALL_CONNECT_TIMEOUT_MS=20000
CALL_DISCONNECT_GRACE_MS=10000
CALL_INVITE_LIMIT=6
CALL_SIGNAL_LIMIT=300
CALL_MAX_CANDIDATES=256
CALL_MAX_ACTIVE=1000

# Optional coturn integration. Configure both values together; the secret is
# server-only and must never be copied into client VITE_* variables.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=<long-random-coturn-static-auth-secret>
TURN_CREDENTIAL_TTL_SECONDS=3600
